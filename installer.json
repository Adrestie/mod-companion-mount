{
  "format": "wow-mods-installer/1",
  "module": "mod-companion-mount",
  "title": "Companion Mount",
  "fields": {
    "worldserver": "required",
    "sources": "required",
    "mysql": "required"
  },
  "signature": [
    "src/CompanionMount.cpp",
    "src/companion_mount_loader.cpp"
  ],
  "exclude_from_sources": [
    "data/lua"
  ],
  "configuration": {
    "file": "mod-companion-mount.conf",
    "template": "conf/mod-companion-mount.conf.dist"
  },
  "lua": {
    "folder": "CompanionMount",
    "sources": [
      "data/lua/CompanionMount"
    ]
  },
  "database": {
    "characters": {
      "tables": [
        "mod_companion_mount_character",
        "mod_companion_mount_mount"
      ],
      "kept_on_update": [
        "mod_companion_mount_character",
        "mod_companion_mount_mount"
      ],
      "rows": [
        {
          "table": "updates",
          "where": "name IN ({sql_files:characters})"
        }
      ]
    },
    "world": {
      "rows": [
        {
          "table": "module_string",
          "where": "module = 'mod-companion-mount'"
        },
        {
          "table": "module_string_locale",
          "where": "module = 'mod-companion-mount'"
        },
        {
          "table": "creature_template",
          "where": "entry = 91000"
        },
        {
          "table": "creature_template_model",
          "where": "CreatureID = 91000"
        },
        {
          "table": "creature_template_locale",
          "where": "entry = 91000"
        },
        {
          "table": "spell_dbc",
          "where": "ID = 91000"
        },
        {
          "table": "npc_spellclick_spells",
          "where": "npc_entry = 91000"
        },
        {
          "table": "command",
          "where": "name = 'companion' OR name LIKE 'companion %'"
        },
        {
          "table": "updates",
          "where": "name IN ({sql_files:world})"
        }
      ]
    }
  }
}
