#
# mod-companion-mount configuration
#
# Copy this file to mod-companion-mount.conf in the folder of the module
# configurations (configs/modules) to change its values.
#

[worldserver]

########################################
# Companion mount
########################################
#
#    CompanionMount.Enable
#        Description: Turns the module on or off. Off, no companion mount
#                     comes out and the commands answer that it is disabled.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.Enable = 1

#
#    CompanionMount.AllowInDungeons
#        Description: Lets the companion mount follow its master into
#                     dungeons and raids (outdoor parts only).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

CompanionMount.AllowInDungeons = 0

#
#    CompanionMount.AllowInBattlegrounds
#        Description: Lets the companion mount follow its master into
#                     battlegrounds and arenas (outdoor parts only).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

CompanionMount.AllowInBattlegrounds = 0

#
#    CompanionMount.InstantMount
#        Description: A right click on the companion mount mounts at once.
#                     Off, the mount spell is cast as from the spellbook: its
#                     usual cast time, and not in combat.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

CompanionMount.InstantMount = 0

#
#    CompanionMount.ReviveDelay
#        Description: Seconds before a companion mount that fell comes back.
#        Default:     60

CompanionMount.ReviveDelay = 60

#
#    CompanionMount.HealthRate
#    CompanionMount.DamageRate
#        Description: Multipliers of the health and damage of a creature of
#                     the master's level (creature_classlevelstats).
#        Default:     1.0

CompanionMount.HealthRate = 1.0
CompanionMount.DamageRate = 1.0

#
#    CompanionMount.AttackPowerOwnerShare
#        Description: Share of its master's attack power the companion mount
#                     adds to that of the creatures of its level (as a hunter
#                     pet takes a share of its master's). 0.22 = 22 %.
#        Default:     0.22

CompanionMount.AttackPowerOwnerShare = 0.22

#
#    CompanionMount.LeashDistance
#        Description: Yards from its master past which the companion mount
#                     drops its prey and comes back. Twice that distance, it
#                     is summoned again at its master's side.
#        Default:     40

CompanionMount.LeashDistance = 40

#
#    CompanionMount.ClickDistance
#        Description: Yards from which a right click on the companion mount
#                     mounts it.
#        Default:     10

CompanionMount.ClickDistance = 10

#
#    CompanionMount.AutoLoot.Enable
#        Description: Out of combat, while it follows, the companion mount
#                     walks to the corpses its master may loot and loots them
#                     for him, as if he did: same rights, same rolls, the loot
#                     goes to his bags. It leaves what the loot window would
#                     not let him take (rolls, master looter, another's turn).
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.AutoLoot.Enable = 1

#
#    CompanionMount.AutoLoot.Range
#        Description: Yards around the master within which the companion
#                     mount looks for corpses to loot.
#        Default:     30

CompanionMount.AutoLoot.Range = 30

#
#    CompanionMount.KillsRewardOwner
#        Description: The blows of the companion mount count as its master's
#                     for loot and rewards (experience, reputation, quests).
#                     The core gives them only when a PLAYER struck: without
#                     this, a creature the companion mount kills alone drops
#                     nothing, as one a pet kills alone.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.KillsRewardOwner = 1

########################################
# Levels
########################################
#
#    CompanionMount.Level.Enable
#        Description: Each mount has its own level and experience. Off, the
#                     companion mount simply takes its master's level.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.Level.Enable = 1

#
#    CompanionMount.Level.Start
#        Description: The level of a mount the first time it comes out.
#        Default:     1

CompanionMount.Level.Start = 1

#
#    CompanionMount.Level.CapToOwner
#        Description: A mount never goes past its master's level (as a pet).
#                     Off, only the server's highest level stops it.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.Level.CapToOwner = 1

#
#    CompanionMount.Level.XpNeedRate
#        Description: Share of what a player needs for a level that a mount
#                     needs for the same level (0.05 = 5 %, as hunter pets).
#        Default:     0.05

CompanionMount.Level.XpNeedRate = 0.05

#
#    CompanionMount.Level.XpKillRate
#        Description: Multiplier of the experience a kill gives the mount:
#                     the core's formula at the mount's level, twice for an
#                     elite.
#        Default:     1.0

CompanionMount.Level.XpKillRate = 1.0

#
#    CompanionMount.Level.SharedPercent
#        Description: Percentage of the experience of the mount out that every
#                     other mount of the character receives, even those that
#                     never came out yet.
#        Default:     10

CompanionMount.Level.SharedPercent = 10

########################################
# Saddlebags
########################################
#
#    CompanionMount.Bag.Slots
#        Description: Places in the saddlebags of each mount.
#        Default:     50

CompanionMount.Bag.Slots = 50

#
#    CompanionMount.Bag.RequiresOut
#        Description: The companion mount must be out, or the player mounted,
#                     to put items into the saddlebags or take them back.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.Bag.RequiresOut = 1

########################################
# Talents
########################################
#
#    CompanionMount.Talent.FirstLevel
#    CompanionMount.Talent.LevelsPerPoint
#        Description: A mount gets its first talent point at FirstLevel, then
#                     one more every LevelsPerPoint levels: 39 points at level
#                     80 by default (levels 4, 6, ... 80).
#        Default:     4, 2

CompanionMount.Talent.FirstLevel = 4
CompanionMount.Talent.LevelsPerPoint = 2

#
#    CompanionMount.Talent.PointsPerTier
#        Description: Points to spend in a tree to reach each next row.
#        Default:     3

CompanionMount.Talent.PointsPerTier = 3

#
#    CompanionMount.Talent.OneTree
#        Description: A mount learns in one tree only (DPS, Tank or Heal),
#                     chosen by its first point; a reset frees it.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

CompanionMount.Talent.OneTree = 1
